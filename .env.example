DATABASE_URL=postgres://postgres:postgres@localhost:5432/admin
REDIS_URL=redis://127.0.0.1:6379
# Must be unique and >=32 chars. The default.toml placeholder is rejected at boot.
# Generate one with: openssl rand -hex 32
JWT__SECRET=replace_with_openssl_rand_hex_32_at_least_32_chars
SERVER__ADDR=0.0.0.0:8080
RUN_MODE=development
RUST_LOG=info,sqlx=warn,sea_orm=warn
